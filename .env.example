# SPECTRE OSINT configuration
# Copy this file to .env and fill only the keys you have.
# Never commit .env. SPECTRE never requires paid APIs to run.

# --- Runtime ---
SPECTRE_DATA_DIR=./data
SPECTRE_REPORTS_DIR=./reports
SPECTRE_LOGS_DIR=./logs
SPECTRE_LOG_LEVEL=INFO
SPECTRE_DATABASE_URL=sqlite:///./data/spectre.db
SPECTRE_HTTP_TIMEOUT=20
SPECTRE_MAX_CONCURRENCY=8
SPECTRE_USER_AGENT=SPECTRE-OSINT/0.1-alpha (+passive-osint)
SPECTRE_HTTP_MAX_RETRIES=3
SPECTRE_SSRF_ENABLED=true
SPECTRE_ALLOW_PRIVATE_TARGETS=false
SPECTRE_ALLOW_PUBLIC_BIND=false
SPECTRE_WEB_HOST=127.0.0.1
SPECTRE_PIVOT_BUDGET=8

# Cache TTLs in seconds
SPECTRE_CACHE_DNS_TTL=600
SPECTRE_CACHE_RDAP_TTL=86400
SPECTRE_CACHE_VT_TTL=3600
SPECTRE_CACHE_CRTSH_TTL=21600
SPECTRE_CACHE_DEFAULT_TTL=1800
SPECTRE_CACHE_USERNAME_TTL=21600
SPECTRE_CACHE_WAYBACK_TTL=21600
SPECTRE_CACHE_HEALTH_TTL=900

# Authenticated public OSINT (never inside the git repo)
# SPECTRE_AUTH_DIR=~/.local/share/spectre/auth
# SPECTRE-owned Chromium profiles (never personal Chrome/Edge):
# SPECTRE_BROWSER_PROFILES_DIR=~/.local/share/spectre/browser-profiles
# SPECTRE-owned Google Chrome CDP profiles (Windows/WSL: %USERPROFILE%\.spectre\chrome\<platform>):
# SPECTRE_CHROME_PATH=
# SPECTRE_CHROME_PROFILES_DIR=
# SPECTRE_WINDOWS_USERPROFILE=
SPECTRE_BROWSER_BACKEND=playwright
# Collection Chrome CDP default is non-intrusive (reuse or minimized). Login stays visible.
# SPECTRE_BROWSER_VISIBLE=false
SPECTRE_KEYRING=true

# --- APIs ---
# SPECTRE is useful with zero keys. Missing keys are NOT CONFIGURED, not a crash.
#
# KEYLESS (always attempted): crt.sh, RDAP, Wayback
# OPTIONAL (works without; key raises quota): GitHub, URLScan, IPinfo, GreyNoise, AlienVault OTX
# REQUIRED (skipped until set): VirusTotal, Shodan, Censys, AbuseIPDB, HIBP
#
# Probe live status: spectre providers --probe
# Probe one:         spectre providers --probe --name github
# VirusTotal — domain/IP/URL/hash intel (REQUIRED)
VIRUSTOTAL_API_KEY=

# Shodan — historical services (not a live scan) (REQUIRED)
SHODAN_API_KEY=

# Censys — with CENSYS_API_SECRET (REQUIRED)
CENSYS_API_ID=
CENSYS_API_SECRET=

# URLScan (OPTIONAL)
URLSCAN_API_KEY=

# AbuseIPDB — IP abuse score (REQUIRED)
ABUSEIPDB_API_KEY=

# HIBP — email breach records (authorized API) (REQUIRED)
HIBP_API_KEY=

# IPinfo — IP geolocation (OPTIONAL)
IPINFO_TOKEN=

# GreyNoise — noise/riot classification (OPTIONAL)
GREYNOISE_API_KEY=

# GitHub token — higher rate limit + code search (OPTIONAL)
GITHUB_TOKEN=

# AlienVault OTX — pulses (OPTIONAL)
OTX_API_KEY=

# --- Optional Google CSE (`spectre search`); not in the default pipeline ---
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Optional local SearXNG (loopback only). Discovery works without it. ---
# SEARXNG_URL=http://127.0.0.1:8080
# SPECTRE_SEARCH_QUERY_BUDGET=12
# SPECTRE_SEARCH_MAX_PIVOTS=25
# SPECTRE_SEARCH_MAX_DEPTH=2

# chmod 600 .env after filling keys.
# PostgreSQL is experimental and untested in v0.1-alpha; keep SQLite unless you
# run your own migrations and tests.

# --- Optional LLM (`LLM_ENABLED=true`; output always tagged AI_ANALYSIS) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
LLM_ENABLED=false
